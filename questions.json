function generateHardVariant(base) {
const distractors = [
"تعتمد على طول المورثة فقط",
"لا تتأثر بالحرارة",
"تحدث في السيتوبلازم فقط دائماً",
"لا تحتاج طاقة",
"تتم دون إنزيمات",
"مرتبطة فقط بالدهون"
];

const q = { ...base };

if (Math.random() > 0.5) {
const wrong = distractors[Math.floor(Math.random()*distractors.length)];
q.choices[Math.floor(Math.random()*4)] = wrong;
}

return q;
}

let result = [];

for (let i = 0; i < 1000; i++) {
const template = templates[Math.floor(Math.random()*templates.length)];
const q = generateHardVariant(template());
result.push(q);
}

fs.writeFileSync("questions.json", JSON.stringify(result, null, 2), "utf8");

